<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LMS & ID Strategic Alignment 2026</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lucide/0.263.1/lucide.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
        .transition-all { transition-property: all; transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1); transition-duration: 300ms; }
        .hover-trigger .hover-target { display: none; }
        .hover-trigger:hover .hover-target { display: block; }
        .active-tab { border-bottom: 2px solid #ea580c; color: #ea580c; font-weight: 600; }
        .inactive-tab { color: #6b7280; }
        .inactive-tab:hover { color: #374151; }
    </style>
</head>
<body class="bg-slate-50 text-slate-900">

    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center gap-3">
                    <div class="bg-orange-600 text-white p-2 rounded-lg">
                        <i data-lucide="layers" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold text-slate-900 tracking-tight">LMS & ID Operations Center</h1>
                        <p class="text-xs text-slate-500 font-medium">2026 STRATEGIC ALIGNMENT • <span class="text-orange-600">HUNTER DOUGLAS</span></p>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                     <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-semibold border border-green-200">Status: ON TRACK</span>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <div class="border-b border-slate-200 mb-8">
            <nav class="-mb-px flex space-x-8" aria-label="Tabs">
                <button onclick="switchTab('scope')" id="tab-scope" class="active-tab whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm flex items-center gap-2">
                    <i data-lucide="target" class="w-4 h-4"></i> My Strategic Scope
                </button>
                <button onclick="switchTab('engine')" id="tab-engine" class="inactive-tab whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm flex items-center gap-2">
                    <i data-lucide="cpu" class="w-4 h-4"></i> The Ops Engine (Workflow)
                </button>
                <button onclick="switchTab('kpi')" id="tab-kpi" class="inactive-tab whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm flex items-center gap-2">
                    <i data-lucide="bar-chart-2" class="w-4 h-4"></i> Performance KPIs
                </button>
            </nav>
        </div>

        <div id="content-scope" class="space-y-6 animate-fade-in">
            <div class="bg-blue-900 rounded-2xl p-8 text-white shadow-xl relative overflow-hidden">
                <div class="relative z-10 max-w-2xl">
                    <h2 class="text-3xl font-bold mb-4">From "Task Taker" to "System Owner"</h2>
                    <p class="text-blue-100 text-lg leading-relaxed mb-6">
                        My 2026 strategy focuses on transitioning LMS administration from manual tracking to a scalable, data-driven operation, while owning the full-stack creation of high-quality onboarding assets.
                    </p>
                </div>
                <div class="absolute right-0 bottom-0 opacity-10 pointer-events-none">
                    <i data-lucide="compass" class="w-64 h-64 -mb-12 -mr-12"></i>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all group">
                    <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                        <i data-lucide="globe" class="w-6 h-6"></i>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Global Onboarding</h3>
                    <p class="text-sm text-slate-600 mb-4">Ownership of the digital asset lifecycle and LMS deployment for the new global framework.</p>
                    <ul class="text-xs space-y-2 text-slate-500">
                        <li class="flex items-center gap-2"><i data-lucide="check-circle" class="w-3 h-3 text-green-500"></i> Full-Stack ID (Articulate/Canva)</li>
                        <li class="flex items-center gap-2"><i data-lucide="check-circle" class="w-3 h-3 text-green-500"></i> Pilot Launch & Tracking</li>
                    </ul>
                </div>

                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all group">
                    <div class="w-12 h-12 bg-orange-50 text-orange-600 rounded-lg flex items-center justify-center mb-4 group-hover:bg-orange-600 group-hover:text-white transition-colors">
                        <i data-lucide="settings" class="w-6 h-6"></i>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">LMS Operational Excellence</h3>
                    <p class="text-sm text-slate-600 mb-4">Transitioning from email/Excel to a Jira-based ticketing system to ensure data integrity.</p>
                    <ul class="text-xs space-y-2 text-slate-500">
                        <li class="flex items-center gap-2"><i data-lucide="check-circle" class="w-3 h-3 text-green-500"></i> Jira Service Desk Implementation</li>
                        <li class="flex items-center gap-2"><i data-lucide="check-circle" class="w-3 h-3 text-green-500"></i> SLA Management & Reporting</li>
                    </ul>
                </div>

                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all group">
                    <div class="w-12 h-12 bg-slate-50 text-slate-600 rounded-lg flex items-center justify-center mb-4 group-hover:bg-slate-800 group-hover:text-white transition-colors">
                        <i data-lucide="users" class="w-6 h-6"></i>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 mb-2">Learner Experience</h3>
                    <p class="text-sm text-slate-600 mb-4">Providing rapid technical support and optimizing the user journey within SABA.</p>
                    <ul class="text-xs space-y-2 text-slate-500">
                        <li class="flex items-center gap-2"><i data-lucide="check-circle" class="w-3 h-3 text-green-500"></i> Technical Troubleshooting</li>
                        <li class="flex items-center gap-2"><i data-lucide="check-circle" class="w-3 h-3 text-green-500"></i> UX/UI Improvements</li>
                    </ul>
                </div>
            </div>
        </div>

        <div id="content-engine" class="hidden space-y-8 animate-fade-in">
             <div class="bg-white rounded-xl border border-slate-200 p-8 shadow-sm">
                <h3 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
                    <i data-lucide="workflow" class="text-orange-600"></i> The "Full-Stack" Workflow
                </h3>
                
                <div class="relative">
                    <div class="absolute top-1/2 left-0 w-full h-1 bg-slate-100 -translate-y-1/2 z-0 hidden md:block"></div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 relative z-10">
                        <div class="bg-white border border-slate-200 p-4 rounded-lg hover:border-orange-500 cursor-pointer transition-all group text-center">
                            <div class="bg-blue-50 text-blue-600 w-10 h-10 rounded-full flex items-center justify-center mx-auto mb-3 font-bold group-hover:bg-orange-600 group-hover:text-white">1</div>
                            <h4 class="font-bold text-sm">Intake (Jira)</h4>
                            <p class="text-xs text-slate-500 mt-1">Single Entry Point</p>
                            <div class="hidden group-hover:block absolute top-full left-0 w-full mt-2 bg-slate-800 text-white text-xs p-3 rounded z-20 shadow-lg text-left">
                                <strong>Consolidated Request Types:</strong><br>
                                • Content Build (ID)<br>
                                • Complex Program (Live + eLearning)<br>
                                • Tech Support
                            </div>
                        </div>

                        <div class="bg-white border border-slate-200 p-4 rounded-lg hover:border-orange-500 cursor-pointer transition-all group text-center">
                            <div class="bg-purple-50 text-purple-600 w-10 h-10 rounded-full flex items-center justify-center mx-auto mb-3 font-bold group-hover:bg-orange-600 group-hover:text-white">2</div>
                            <h4 class="font-bold text-sm">Production</h4>
                            <p class="text-xs text-slate-500 mt-1">Canva • Synthesia • Articulate</p>
                            <div class="hidden group-hover:block absolute top-full left-0 w-full mt-2 bg-slate-800 text-white text-xs p-3 rounded z-20 shadow-lg text-left">
                                <strong>My Responsibility:</strong><br>
                                • Scripting & Storyboarding<br>
                                • AI Video Generation (Synthesia)<br>
                                • SCORM Packaging
                            </div>
                        </div>

                        <div class="bg-white border border-slate-200 p-4 rounded-lg hover:border-orange-500 cursor-pointer transition-all group text-center">
                            <div class="bg-indigo-50 text-indigo-600 w-10 h-10 rounded-full flex items-center justify-center mx-auto mb-3 font-bold group-hover:bg-orange-600 group-hover:text-white">3</div>
                            <h4 class="font-bold text-sm">Deployment (SABA)</h4>
                            <p class="text-xs text-slate-500 mt-1">LMS Configuration</p>
                            <div class="hidden group-hover:block absolute top-full left-0 w-full mt-2 bg-slate-800 text-white text-xs p-3 rounded z-20 shadow-lg text-left">
                                <strong>Admin Tasks:</strong><br>
                                • Cohort Creation<br>
                                • Assignment Rules<br>
                                • Live Session Scheduling
                            </div>
                        </div>

                         <div class="bg-white border border-slate-200 p-4 rounded-lg hover:border-orange-500 cursor-pointer transition-all group text-center">
                            <div class="bg-green-50 text-green-600 w-10 h-10 rounded-full flex items-center justify-center mx-auto mb-3 font-bold group-hover:bg-orange-600 group-hover:text-white">4</div>
                            <h4 class="font-bold text-sm">Analytics</h4>
                            <p class="text-xs text-slate-500 mt-1">Data & Reporting</p>
                            <div class="hidden group-hover:block absolute top-full left-0 w-full mt-2 bg-slate-800 text-white text-xs p-3 rounded z-20 shadow-lg text-left">
                                <strong>Outputs:</strong><br>
                                • Completion Reports<br>
                                • SLA Compliance Data<br>
                                • Learner NPS
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-slate-900 text-white p-6 rounded-xl shadow-lg">
                    <h4 class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-2">The New Standard</h4>
                    <h3 class="text-xl font-bold mb-4">Unified Intake Model</h3>
                    <p class="text-sm text-slate-300 mb-6">
                        Replacing scattered emails with structured Jira tickets. Specifically merging "Live Sessions" and "E-Learning" into a single <strong>Complex Program</strong> workflow to reduce friction.
                    </p>
                    <div class="flex items-center gap-4 text-xs font-mono bg-slate-800 p-3 rounded">
                        <span class="text-green-400">➜</span> Request.Type == "Program" <span class="text-slate-500">// Trigger Live + Digital flows</span>
                    </div>
                </div>
                <div class="bg-orange-50 border border-orange-100 p-6 rounded-xl">
                    <h4 class="text-sm font-semibold uppercase tracking-wider text-orange-600 mb-2">Benefit</h4>
                    <h3 class="text-xl font-bold text-orange-900 mb-4">Why this matters?</h3>
                    <ul class="space-y-3">
                        <li class="flex items-start gap-3">
                            <i data-lucide="check" class="w-5 h-5 text-orange-600 mt-0.5"></i>
                            <span class="text-sm text-orange-900"><strong>Data Visibility:</strong> We move from "Who is working on what?" to real-time dashboards.</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i data-lucide="check" class="w-5 h-5 text-orange-600 mt-0.5"></i>
                            <span class="text-sm text-orange-900"><strong>Protected Time:</strong> Distinct categories allow me to prioritize "Deep Work" (ID) over "Quick Fixes."</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div id="content-kpi" class="hidden space-y-6 animate-fade-in">
            <div class="flex justify-between items-center mb-2">
                <h2 class="text-xl font-bold text-slate-900">Strategic KPIs (2026 Targets)</h2>
                <div class="text-sm text-slate-500">Based on "Operational Excellence" Pillar</div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-4 opacity-10"><i data-lucide="clock" class="w-16 h-16"></i></div>
                    <div class="text-sm font-medium text-slate-500 mb-1">SLA Compliance</div>
                    <div class="text-3xl font-bold text-slate-900 mb-2">90%</div>
                    <div class="w-full bg-slate-100 rounded-full h-2 mb-2">
                        <div class="bg-green-500 h-2 rounded-full" style="width: 90%"></div>
                    </div>
                    <p class="text-xs text-slate-500">Target for P2 & P3 operational requests (enrollments, reports) via Jira.</p>
                </div>

                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-4 opacity-10"><i data-lucide="shield-check" class="w-16 h-16"></i></div>
                    <div class="text-sm font-medium text-slate-500 mb-1">QA Pass Rate</div>
                    <div class="text-3xl font-bold text-slate-900 mb-2">100%</div>
                    <div class="w-full bg-slate-100 rounded-full h-2 mb-2">
                        <div class="bg-blue-500 h-2 rounded-full" style="width: 100%"></div>
                    </div>
                    <p class="text-xs text-slate-500">Of Global Onboarding modules pass technical QA 1 week prior to pilot.</p>
                </div>

                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-4 opacity-10"><i data-lucide="zap" class="w-16 h-16"></i></div>
                    <div class="text-sm font-medium text-slate-500 mb-1">Critical Response</div>
                    <div class="text-3xl font-bold text-slate-900 mb-2">&lt; 4 Hrs</div>
                    <div class="w-full bg-slate-100 rounded-full h-2 mb-2">
                        <div class="bg-orange-500 h-2 rounded-full" style="width: 85%"></div>
                    </div>
                    <p class="text-xs text-slate-500">First response time for P1 "Blocker" issues (Login/System Down).</p>
                </div>
            </div>

            <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm mt-8">
                <div class="bg-slate-50 px-6 py-4 border-b border-slate-200">
                    <h3 class="font-bold text-slate-800">Operational Shift: The "Why"</h3>
                </div>
                <table class="w-full text-sm text-left">
                    <thead class="text-xs text-slate-500 uppercase bg-slate-50 border-b border-slate-100">
                        <tr>
                            <th class="px-6 py-3 w-1/3">Metric</th>
                            <th class="px-6 py-3 text-red-600">Current State (Manual)</th>
                            <th class="px-6 py-3 text-green-600">Future State (Jira-Driven)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <tr class="hover:bg-slate-50">
                            <td class="px-6 py-4 font-medium text-slate-900">Request Tracking</td>
                            <td class="px-6 py-4 text-slate-500">Excel / Email (Decentralized)</td>
                            <td class="px-6 py-4 text-slate-900 font-semibold">Jira Service Management (Centralized)</td>
                        </tr>
                         <tr class="hover:bg-slate-50">
                            <td class="px-6 py-4 font-medium text-slate-900">Complex Programs</td>
                            <td class="px-6 py-4 text-slate-500">Multiple threads for Live vs. LMS</td>
                            <td class="px-6 py-4 text-slate-900 font-semibold">Single Unified Ticket Workflow</td>
                        </tr>
                         <tr class="hover:bg-slate-50">
                            <td class="px-6 py-4 font-medium text-slate-900">Capacity Planning</td>
                            <td class="px-6 py-4 text-slate-500">Reactive ("Awaiting Resources")</td>
                            <td class="px-6 py-4 text-slate-900 font-semibold">Predictive (SLA & Backlog View)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <script>
        // Initialize Lucide icons
        lucide.createIcons();

        function switchTab(tabName) {
            // Hide all content
            document.getElementById('content-scope').classList.add('hidden');
            document.getElementById('content-engine').classList.add('hidden');
            document.getElementById('content-kpi').classList.add('hidden');
            
            // Show selected content
            document.getElementById('content-' + tabName).classList.remove('hidden');

            // Reset tab styles
            const tabs = ['scope', 'engine', 'kpi'];
            tabs.forEach(t => {
                const tabBtn = document.getElementById('tab-' + t);
                if (t === tabName) {
                    tabBtn.classList.remove('inactive-tab');
                    tabBtn.classList.add('active-tab');
                } else {
                    tabBtn.classList.remove('active-tab');
                    tabBtn.classList.add('inactive-tab');
                }
            });
        }
    </script>
</body>
</html>
